# PulseLens — copy to backend/.env and pulselens-dashboard/.env.local

# Backend (default port 3001)
PORT=3001
NODE_ENV=development
DEMO_MODE=false
MOCK_HARDWARE=false

# Database (server-side only — never in Lens bundle)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI services (server-side only)
GEMINI_API_KEY=your-gemini-api-key
FISH_AUDIO_API_KEY=your-fish-audio-api-key
LETTA_API_KEY=

# CORS (production: set your deployed dashboard URL; comma-separated for multiple)
# In development, all http://localhost:<port> origins are auto-allowed
DASHBOARD_ORIGIN=http://localhost:3000

# Dashboard (proxied via Next.js rewrites — no CORS needed in dev)
API_URL=http://localhost:3001
